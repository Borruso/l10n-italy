<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="wizard_import_fatturapa_form" model="ir.ui.view">
        <field name="name">wizard_import_fatturapa_form</field>
        <field name="model">wizard.import.fatturapa</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field
                            name="l10n_it_edi_attachment"
                            filename="l10n_it_edi_attachment_filename"
                        />
                        <field name="l10n_it_edi_attachment_filename" invisible="1" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import Files"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="btn-primary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import_fatturapa" model="ir.actions.act_window">
        <field name="name">Import E-bill ZIP Files</field>
        <field name="res_model">wizard.import.fatturapa</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field
            name="view_id"
            ref="l10n_it_edi_import_zip.wizard_import_fatturapa_form"
        />
    </record>

    <menuitem
        id="menu_wizard_import_fatturapa"
        action="l10n_it_edi_import_zip.action_wizard_import_fatturapa"
        parent="account.menu_finance_payables"
    />
</odoo>
